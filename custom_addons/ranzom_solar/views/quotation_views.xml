<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Quotation List -->
    <record id="view_ranzom_solar_quotation_list" model="ir.ui.view">
        <field name="name">ranzom.solar.quotation.list</field>
        <field name="model">ranzom.solar.quotation</field>
        <field name="arch" type="xml">
            <list string="Solar Quotations">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="quotation_type"/>
                <field name="capacity"/>
                <field name="total"/>
                <field name="net_investment"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Quotation Form -->
    <record id="view_ranzom_solar_quotation_form" model="ir.ui.view">
        <field name="name">ranzom.solar.quotation.form</field>
        <field name="model">ranzom.solar.quotation</field>
        <field name="arch" type="xml">
            <form string="Solar Quotation">
                <header>
                    <button name="action_convert_to_sale"
                            type="object"
                            string="Convert to Sales Quotation"
                            class="btn-primary"
                            invisible="state != 'draft' or quotation_type != 'customer'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,converted,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Quotation Details">
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                            <field name="quotation_type"/>
                            <field name="date"/>
                            <field name="validity_date"/>
                        </group>
                        <group string="Solar System">
                            <field name="system_type"/>
                            <field name="capacity"/>
                            <field name="panel_brand"/>
                            <field name="inverter_brand"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Quotation Components">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="unit_price"/>
                                    <field name="amount" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Terms &amp; Notes">
                            <group>
                                <field name="payment_terms"/>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>

                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Quotation Summary">
                            <field name="subtotal"/>
                            <field name="discount"/>
                            <field name="total"/>
                            <field name="subsidy_amount"/>
                            <field name="net_investment"/>
                        </group>
                    </group>

                    <group string="Sales Integration">
                        <field name="sale_order_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quotation Action -->
    <record id="action_ranzom_solar_quotations" model="ir.actions.act_window">
        <field name="name">Solar Quotations</field>
        <field name="res_model">ranzom.solar.quotation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Quotation Menu -->
    <menuitem id="menu_ranzom_solar_quotations"
              name="Quotations"
              parent="crm.crm_menu_root"
              action="action_ranzom_solar_quotations"
              sequence="30"/>

</odoo>
